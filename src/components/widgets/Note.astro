---
import { Icon } from 'astro-icon/components';

export interface Props {
  icon?: string;
  title?: string;
  description?: string;
}

const {
  icon = 'tabler:info-square',
  title = await Astro.slots.render('title'),
  description = await Astro.slots.render('description'),
} = Astro.props;
---

<section class="relative not-prose overflow-hidden bg-gradient-to-r from-[#194C6E] via-[#1a5c84] to-[#0d7ab5] dark:from-slate-900 dark:to-slate-800">
  <div
    class="absolute inset-0 opacity-10 [background-image:repeating-linear-gradient(-45deg,transparent,transparent_8px,white_8px,white_9px)]"
  >
  </div>
  <div class="relative max-w-6xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-center gap-3 flex-wrap text-white">
    <span class="inline-flex items-center gap-1.5 bg-white/20 rounded-full px-3 py-1 text-sm font-bold uppercase tracking-wider">
      <Icon name={icon} class="w-4 h-4" aria-hidden="true" />
      <span set:html={title} />
    </span>
    <span class="text-white/90 text-sm font-medium" set:html={description} />
  </div>
</section>
