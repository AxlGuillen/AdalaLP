---
import Layout from '~/layouts/PageLayout.astro';
import ApplicationForm from '~/components/widgets/Form';
import TextTypeWrapper from '~/components/custom/TextType.vue';

const metadata = {
  title: 'Aplicar | ADALA',
  description: 'Envía tu aplicación a ADALA con tus datos y currículum en PDF.',
};
---

<Layout metadata={metadata}>
  <section class="min-h-[75vh] mx-auto max-w-3xl py-12 px-4 sm:px-6 lg:px-8 hideLanguage">
    <header class="mb-8 text-center">
      <h1 class="text-4xl text-accent font-bold tracking-tight dark:text-white motion-safe:md:intersect:animate-wave">
        Aplicación a Vacante
      </h1>
      <TextTypeWrapper
        text="Completa tus datos y adjunta tu currículum. Te contactaremos por correo."
        client:only="vue"
      />
    </header>

    <!-- Isla de React -->
    <ApplicationForm client:load />
  </section>
</Layout>
