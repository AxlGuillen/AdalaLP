---
import Layout from '~/layouts/PageLayout.astro';
import ContactForm from '~/components/widgets/ContactForm';

const metadata = {
  title: 'Contacto | ADALA',
  description: 'Solicita información sobre nuestros servicios de migración, certificación laboral y turismo corporativo.',
};
---

<Layout metadata={metadata}>
  <section class="relative overflow-hidden min-h-screen flex flex-col justify-center py-20 px-4">

    <!-- Fondo gradiente + dots -->
    <div class="absolute inset-0 bg-gradient-to-br from-primary to-secondary"></div>
    <div class="absolute inset-0 [background-image:radial-gradient(circle,_#00000022_1px,_transparent_1px)] [background-size:28px_28px]"></div>

    <!-- Card única con header + form -->
    <div class="relative max-w-lg w-full mx-auto">
      <div class="bg-white dark:bg-slate-900 rounded-2xl shadow-2xl overflow-hidden">

        <!-- Header dentro del card -->
        <div class="px-6 pt-6 pb-[18px] border-b border-gray-100 dark:border-gray-800 text-center">
          <p class="text-sm font-semibold text-primary uppercase tracking-wider mb-2">Contáctanos</p>
          <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-1">Solicita información</h1>
          <p class="text-sm text-gray-500 dark:text-gray-400">
            Cuéntanos sobre tu caso y un asesor se pondrá en contacto contigo.
          </p>
        </div>

        <!-- Form -->
        <div class="px-6 py-[18px]">
          <ContactForm lang="es" client:only="react" />
        </div>

      </div>
    </div>

  </section>
</Layout>
