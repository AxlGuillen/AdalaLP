# Supabase — credenciales del proyecto que aloja la tabla adala_prospects.
# Copia este archivo a .env y rellena con los valores reales del dashboard:
# Project Settings -> API Keys

# URL del proyecto (Project Settings -> Data API)
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable key (Project Settings -> API Keys -> Publishable keys)
# Es pública por diseño; la seguridad vive en las políticas RLS de la tabla.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
